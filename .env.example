# -----------------------------------------------------------------------------
# Aegis Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# -----------------------------------------------------------------------------

# Application Metadata
APP_NAME="Aegis"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# API Configuration
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Database Configuration (PostgreSQL)
# For local container / host setup:
POSTGRES_USER="aegis_user"
POSTGRES_PASSWORD="aegis_dev_password"
POSTGRES_DB="aegis_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg://aegis_user:aegis_dev_password@localhost:5432/aegis_db"

# Security & CORS
# Comma-separated or JSON list of allowed origins for local development
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
SECRET_KEY="dev-insecure-secret-key-change-in-production"

# AI Provider Configuration (Future Foundation)
AI_PROVIDER="mock"
AI_MODEL="claude-3-5-sonnet"
AI_API_KEY=""

# Privacy, Governance & Data Minimization
DATA_POLICY_MODE="STANDARD"
PRIVACY_SALT="aegis-privacy-salt-secret-change-in-production"

# Resource & Investigation Limits
MAX_QUERY_WINDOW_HOURS=24
MAX_RECORDS_PER_TOOL_CALL=50
MAX_CONTEXT_RECORDS=200
MAX_TOOL_CALLS_PER_INVESTIGATION=20
MAX_INVESTIGATION_DURATION_SECONDS=120

# Data Retention Policies (Days)
AUDIT_LOG_RETENTION_DAYS=90
INVESTIGATION_RETENTION_DAYS=180
OPERATIONAL_EVENT_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=60

# Authentication & RBAC
AUTH_ENABLED=false
DEFAULT_DEV_ROLE="OPERATOR"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
FRONTEND_PORT=3000

